#!/usr/bin/env bash
# posteulen-update – spielt eine neue Version ein (SPEC 16.3).
#
#   sudo posteulen-update              neueste Version
#   sudo posteulen-update v0.1.0       bestimmte Version
#   sudo posteulen-update --check      nur anzeigen, was installiert und verfügbar ist
#   sudo posteulen-update --rollback   zurück zur vorigen Version (seitdem entstandene Daten gehen verloren)
#   --verify-tags                      Tag-Signatur gegen deploy/allowed_signers prüfen
#   --yes                              keine Rückfragen
#
# Dieser Befehl holt die neue Version und übergibt dann an deren eigenes Update-Skript, damit
# neue Versionen eigene Schritte mitbringen können.
set -euo pipefail
# shellcheck source=deploy/lib.sh
source /opt/posteulen/current/deploy/lib.sh
require_root

target='' check=0 rollback=0 verify=0
PE_ASSUME_YES=0
while [[ $# -gt 0 ]]; do
  case $1 in
    --check) check=1; shift ;;
    --rollback) rollback=1; shift ;;
    --verify-tags) verify=1; shift ;;
    --yes) PE_ASSUME_YES=1; shift ;;
    -h | --help) sed -n '2,13p' "$0"; exit 0 ;;
    -*) die "Unbekannter Parameter: $1" "Hilfe mit „posteulen-update --help“." ;;
    *) target=$1; shift ;;
  esac
done
export PE_ASSUME_YES

exec 9>/run/posteulen-update.lock
flock -n 9 || die "Es läuft bereits ein Update." "Warten, bis es fertig ist."

current_release=$(readlink -f "$PE_CURRENT")
current_version=$(release_version "$current_release")

if [[ $rollback -eq 1 ]]; then
  exec "$current_release/deploy/update.sh" --rollback
fi

info "Hole verfügbare Versionen …"
git -C "$PE_REPO" fetch --quiet --force --tags origin '+refs/heads/*:refs/heads/*' || die "Repository nicht erreichbar." "Netzwerk und Zugang prüfen."
[[ -n $target ]] || target=$(newest_tag "$PE_REPO")
[[ -n $target ]] || die "Keine Version gefunden."
commit=$(git -C "$PE_REPO" rev-parse --short=12 "$target^{commit}" 2>/dev/null) || die "Version „$target“ gibt es nicht." "Mit „posteulen-update --check“ die verfügbaren Versionen ansehen."

if [[ $check -eq 1 ]]; then
  printf 'Installiert: %s (%s)\nVerfügbar:   %s (%s)\n\n' "$current_version" "$(basename "$current_release")" "$target" "$commit"
  git -C "$PE_REPO" show "$commit:CHANGELOG.md" 2>/dev/null | sed -n '1,60p' || true
  exit 0
fi

if [[ $current_release == *"-$commit" ]]; then
  ok "Version $target ist bereits installiert."
  exit 0
fi

if [[ $verify -eq 1 ]]; then
  git -C "$PE_REPO" -c gpg.format=ssh -c "gpg.ssh.allowedSignersFile=$current_release/deploy/allowed_signers" \
    verify-tag "$target" 2>/dev/null || die "Die Signatur von $target ist ungültig oder fehlt." "Nicht aktualisieren und die Herkunft prüfen."
  ok "Signatur von $target geprüft."
fi

release="$PE_RELEASES/$(tr -c 'A-Za-z0-9._-' '_' <<<"$target" | sed 's/_$//')-$commit"
rm -rf "$release"
mkdir -p "$release"
git -C "$PE_REPO" archive --format=tar "$commit" | tar -x -C "$release"
exec "$release/deploy/update.sh" --apply "$current_release"
