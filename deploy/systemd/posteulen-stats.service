# PostEulen – Messwerte für das Server-Dashboard im Adminpanel (SPEC 13 Punkt 13): CPU- und
# RAM-Auslastung, alle 10 Minuten eine Zeile. Eigene Unit, damit der Hauptdienst mit
# ProcSubset=pid gehärtet bleibt; läuft trotzdem nicht als root, sondern als Dienstbenutzer.
[Unit]
Description=PostEulen – Messwerte für das Server-Dashboard

[Service]
Type=oneshot
User=posteulen
Group=posteulen
ExecStart=/usr/local/sbin/posteulen-server-load /var/lib/posteulen/server-load
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ReadWritePaths=/var/lib/posteulen
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
